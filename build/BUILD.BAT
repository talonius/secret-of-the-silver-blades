@ECHO OFF
REM  Secret of the Silver Blades v1.3: clean DOS build.
REM  TASM assembles the five linked objects, TPC compiles FIXMAIN.PAS and its
REM  units, and Microsoft EXEPACK 4.06 packs FIXMAIN.EXE as START.EXE.
REM  TPC's FIXMAIN.OVR is renamed GAME.OVR. Both shipped products are in E:\OBJ.
REM
REM  build.sh mounts these drives and creates E:\OBJ and E:\BUILD\LOGS:
REM    D: TP 5.5 (TPC.EXE, TURBO.TPL)   E: this version tree
REM    F: TASM 1.0   G: EXEPACK 4.06
REM  C: holds game media; the build commands do not read it. Keep PATH short
REM  to leave conventional memory available to the compiler and linker.
E:
PATH D:\
IF NOT EXIST E:\SRC\NUL GOTO DIRFAIL
IF NOT EXIST E:\OBJ\NUL GOTO DIRFAIL
IF NOT EXIST E:\BUILD\LOGS\NUL GOTO DIRFAIL
CD \SRC

REM  Clear DOS file attributes before deleting generated inputs and products.
REM  Stop if a file survives cleanup; Pascal also searches SRC for {$L} objects.
IF EXIST E:\BUILD\LOGS\TASM.OUT ATTRIB -R -S -H E:\BUILD\LOGS\TASM.OUT
IF EXIST E:\BUILD\LOGS\TASM.OUT DEL E:\BUILD\LOGS\TASM.OUT
IF EXIST E:\BUILD\LOGS\TASM.OUT GOTO CLEANFAIL
IF EXIST E:\BUILD\LOGS\TPC.OUT ATTRIB -R -S -H E:\BUILD\LOGS\TPC.OUT
IF EXIST E:\BUILD\LOGS\TPC.OUT DEL E:\BUILD\LOGS\TPC.OUT
IF EXIST E:\BUILD\LOGS\TPC.OUT GOTO CLEANFAIL
IF EXIST E:\BUILD\LOGS\EXEPACK.OUT ATTRIB -R -S -H E:\BUILD\LOGS\EXEPACK.OUT
IF EXIST E:\BUILD\LOGS\EXEPACK.OUT DEL E:\BUILD\LOGS\EXEPACK.OUT
IF EXIST E:\BUILD\LOGS\EXEPACK.OUT GOTO CLEANFAIL
IF EXIST E:\SRC\*.TPU ATTRIB -R -S -H E:\SRC\*.TPU
IF EXIST E:\SRC\*.TPU DEL E:\SRC\*.TPU
IF EXIST E:\SRC\*.TPU GOTO CLEANFAIL
IF EXIST E:\SRC\*.OBJ ATTRIB -R -S -H E:\SRC\*.OBJ
IF EXIST E:\SRC\*.OBJ DEL E:\SRC\*.OBJ
IF EXIST E:\SRC\*.OBJ GOTO CLEANFAIL
IF EXIST E:\SRC\FIXMAIN.EXE ATTRIB -R -S -H E:\SRC\FIXMAIN.EXE
IF EXIST E:\SRC\FIXMAIN.EXE DEL E:\SRC\FIXMAIN.EXE
IF EXIST E:\SRC\FIXMAIN.EXE GOTO CLEANFAIL
IF EXIST E:\SRC\FIXMAIN.OVR ATTRIB -R -S -H E:\SRC\FIXMAIN.OVR
IF EXIST E:\SRC\FIXMAIN.OVR DEL E:\SRC\FIXMAIN.OVR
IF EXIST E:\SRC\FIXMAIN.OVR GOTO CLEANFAIL
IF EXIST E:\SRC\FIXMAIN.MAP ATTRIB -R -S -H E:\SRC\FIXMAIN.MAP
IF EXIST E:\SRC\FIXMAIN.MAP DEL E:\SRC\FIXMAIN.MAP
IF EXIST E:\SRC\FIXMAIN.MAP GOTO CLEANFAIL
IF EXIST E:\SRC\START.EXE ATTRIB -R -S -H E:\SRC\START.EXE
IF EXIST E:\SRC\START.EXE DEL E:\SRC\START.EXE
IF EXIST E:\SRC\START.EXE GOTO CLEANFAIL
IF EXIST E:\SRC\GAME.OVR ATTRIB -R -S -H E:\SRC\GAME.OVR
IF EXIST E:\SRC\GAME.OVR DEL E:\SRC\GAME.OVR
IF EXIST E:\SRC\GAME.OVR GOTO CLEANFAIL
IF EXIST E:\OBJ\*.TPU ATTRIB -R -S -H E:\OBJ\*.TPU
IF EXIST E:\OBJ\*.TPU DEL E:\OBJ\*.TPU
IF EXIST E:\OBJ\*.TPU GOTO CLEANFAIL
IF EXIST E:\OBJ\*.OBJ ATTRIB -R -S -H E:\OBJ\*.OBJ
IF EXIST E:\OBJ\*.OBJ DEL E:\OBJ\*.OBJ
IF EXIST E:\OBJ\*.OBJ GOTO CLEANFAIL
IF EXIST E:\OBJ\FIXMAIN.EXE ATTRIB -R -S -H E:\OBJ\FIXMAIN.EXE
IF EXIST E:\OBJ\FIXMAIN.EXE DEL E:\OBJ\FIXMAIN.EXE
IF EXIST E:\OBJ\FIXMAIN.EXE GOTO CLEANFAIL
IF EXIST E:\OBJ\FIXMAIN.OVR ATTRIB -R -S -H E:\OBJ\FIXMAIN.OVR
IF EXIST E:\OBJ\FIXMAIN.OVR DEL E:\OBJ\FIXMAIN.OVR
IF EXIST E:\OBJ\FIXMAIN.OVR GOTO CLEANFAIL
IF EXIST E:\OBJ\FIXMAIN.MAP ATTRIB -R -S -H E:\OBJ\FIXMAIN.MAP
IF EXIST E:\OBJ\FIXMAIN.MAP DEL E:\OBJ\FIXMAIN.MAP
IF EXIST E:\OBJ\FIXMAIN.MAP GOTO CLEANFAIL
IF EXIST E:\OBJ\START.EXE ATTRIB -R -S -H E:\OBJ\START.EXE
IF EXIST E:\OBJ\START.EXE DEL E:\OBJ\START.EXE
IF EXIST E:\OBJ\START.EXE GOTO CLEANFAIL
IF EXIST E:\OBJ\GAME.OVR ATTRIB -R -S -H E:\OBJ\GAME.OVR
IF EXIST E:\OBJ\GAME.OVR DEL E:\OBJ\GAME.OVR
IF EXIST E:\OBJ\GAME.OVR GOTO CLEANFAIL
IF NOT EXIST TPC.CFG GOTO NOCFG

REM  The five Pascal units with {$L} link their matching assembly objects.
REM  Assemble every source explicitly and stop before later tools on failure.
F:\TASM BLIT,E:\OBJ\BLIT          > E:\BUILD\LOGS\TASM.OUT
IF ERRORLEVEL 1 GOTO ASMFAIL
IF NOT EXIST E:\OBJ\BLIT.OBJ GOTO ASMFAIL
F:\TASM COREINP,E:\OBJ\COREINP   >> E:\BUILD\LOGS\TASM.OUT
IF ERRORLEVEL 1 GOTO ASMFAIL
IF NOT EXIST E:\OBJ\COREINP.OBJ GOTO ASMFAIL
F:\TASM JOYSTICK,E:\OBJ\JOYSTICK >> E:\BUILD\LOGS\TASM.OUT
IF ERRORLEVEL 1 GOTO ASMFAIL
IF NOT EXIST E:\OBJ\JOYSTICK.OBJ GOTO ASMFAIL
F:\TASM SOUNDDRV,E:\OBJ\SOUNDDRV       >> E:\BUILD\LOGS\TASM.OUT
IF ERRORLEVEL 1 GOTO ASMFAIL
IF NOT EXIST E:\OBJ\SOUNDDRV.OBJ GOTO ASMFAIL
F:\TASM TEXTREND,E:\OBJ\TEXTREND >> E:\BUILD\LOGS\TASM.OUT
IF ERRORLEVEL 1 GOTO ASMFAIL
IF NOT EXIST E:\OBJ\TEXTREND.OBJ GOTO ASMFAIL

REM  TPC reads E:\SRC\TPC.CFG; the driver rejects semicolon comments.
REM  TPC.CFG supplies these options and switch defaults:
REM    /U.;INCLUDES  search the current directory, then INCLUDES (the C_* constant units);
REM                  RTL units are in TURBO.TPL
REM    /L    put the link buffer on disk
REM    /$F+  force far procedure/function calls
REM    /$A-  disable word alignment of variables and typed constants
REM    /$E+  enable 8087 emulation when generating 8087 code
REM    /$N-  use software floating point rather than 8087 code generation
REM    /GD   write a detailed MAP (segments, publics and available line numbers)
REM    /$D+  generate debug information, including MAP line numbers
REM    /$L-  omit local debug symbols
REM    /$R-  disable range checking
REM    /$S-  disable stack checking
REM    /$V+  require matching string lengths for var string parameters
REM  /B rebuilds all units instead of trusting timestamps from an earlier build.
REM  /E sets the EXE, OVR, MAP and TPU output directory; /O locates linked objects.
TPC FIXMAIN.PAS /B /E..\OBJ /O..\OBJ > E:\BUILD\LOGS\TPC.OUT
IF ERRORLEVEL 1 GOTO TPCFAIL
IF NOT EXIST E:\OBJ\FIXMAIN.EXE GOTO TPCFAIL
IF NOT EXIST E:\OBJ\FIXMAIN.OVR GOTO TPCFAIL
IF NOT EXIST E:\OBJ\FIXMAIN.MAP GOTO TPCFAIL

REM  Confirm REN consumed the linked overlay before packing the executable.
REN E:\OBJ\FIXMAIN.OVR GAME.OVR
IF EXIST E:\OBJ\FIXMAIN.OVR GOTO RENFAIL
IF NOT EXIST E:\OBJ\GAME.OVR GOTO RENFAIL
G:\EXEPACK E:\OBJ\FIXMAIN.EXE E:\OBJ\START.EXE > E:\BUILD\LOGS\EXEPACK.OUT
IF ERRORLEVEL 1 GOTO PACKFAIL
IF NOT EXIST E:\OBJ\START.EXE GOTO PACKFAIL
GOTO END

:DIRFAIL
IF EXIST E:\BUILD\LOGS\TPC.OUT ATTRIB -R -S -H E:\BUILD\LOGS\TPC.OUT
ECHO Fatal: BUILD.BAT: a required directory is absent. > E:\BUILD\LOGS\TPC.OUT
GOTO FAILED
:CLEANFAIL
IF EXIST E:\BUILD\LOGS\TPC.OUT ATTRIB -R -S -H E:\BUILD\LOGS\TPC.OUT
ECHO Fatal: BUILD.BAT: a generated file survived cleanup. > E:\BUILD\LOGS\TPC.OUT
GOTO FAILED
:NOCFG
ECHO Fatal: E:\SRC\TPC.CFG is absent; nothing was compiled. > E:\BUILD\LOGS\TPC.OUT
GOTO FAILED
:ASMFAIL
ECHO **Error** BUILD.BAT: assembly failed or an object is absent. >> E:\BUILD\LOGS\TASM.OUT
GOTO FAILED
:TPCFAIL
ECHO Fatal: BUILD.BAT: compilation failed or a link product is absent. >> E:\BUILD\LOGS\TPC.OUT
GOTO FAILED
:RENFAIL
ECHO Fatal: BUILD.BAT: could not rename FIXMAIN.OVR to GAME.OVR. >> E:\BUILD\LOGS\TPC.OUT
GOTO FAILED
:PACKFAIL
ECHO Fatal: BUILD.BAT: EXEPACK failed or START.EXE is absent. >> E:\BUILD\LOGS\EXEPACK.OUT
:FAILED
REM  Clear attributes before discarding previous or partially written products.
IF EXIST E:\OBJ\START.EXE ATTRIB -R -S -H E:\OBJ\START.EXE
IF EXIST E:\OBJ\START.EXE DEL E:\OBJ\START.EXE
IF EXIST E:\OBJ\GAME.OVR ATTRIB -R -S -H E:\OBJ\GAME.OVR
IF EXIST E:\OBJ\GAME.OVR DEL E:\OBJ\GAME.OVR
:END
